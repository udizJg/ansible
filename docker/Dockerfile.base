# ===========================================
# DOCKERFILE BASE PARA ANSIBLE
# ===========================================
# Imagen base con Ansible y herramientas de CI/CD

FROM ubuntu:22.04

# Variables de entorno
ENV DEBIAN_FRONTEND=noninteractive
ENV ANSIBLE_FORCE_COLOR=true
ENV PYTHONUNBUFFERED=1
ENV ANSIBLE_HOST_KEY_CHECKING=False

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    git \
    curl \
    wget \
    vim \
    nano \
    openssh-client \
    openssh-server \
    sudo \
    rsync \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Crear usuario ansible
RUN useradd -m -s /bin/bash ansible && \
    echo "ansible ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Instalar Python packages
RUN pip3 install --upgrade pip setuptools wheel

# Instalar Ansible y herramientas relacionadas
RUN pip3 install \
    ansible==8.5.0 \
    ansible-lint \
    yamllint \
    kubernetes \
    openshift \
    docker \
    boto3 \
    azure-mgmt-compute \
    google-cloud-storage \
    prometheus-client \
    requests \
    jinja2 \
    pyyaml

# Instalar kubectl
RUN curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && \
    mv kubectl /usr/local/bin/

# Instalar Docker CLI
RUN curl -fsSL https://get.docker.com/builds/Linux/x86_64/docker-latest.tgz | tar -xzC /usr/local/bin --strip=1 docker/docker

# Configurar directorio de trabajo
WORKDIR /ansible

# Copiar archivos de configuración
COPY ansible.cfg /etc/ansible/ansible.cfg
COPY inventory/ /ansible/inventory/
COPY playbooks/ /ansible/playbooks/
COPY roles/ /ansible/roles/

# Configurar permisos
RUN chown -R ansible:ansible /ansible && \
    chmod -R 755 /ansible

# Cambiar al usuario ansible
USER ansible

# Verificar instalación
RUN ansible --version && \
    kubectl version --client && \
    docker --version

# Comando por defecto
CMD ["ansible", "--version"] 
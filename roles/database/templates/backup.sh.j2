#!/bin/bash
# ===========================================
# SCRIPT DE RESPALDO DE BASE DE DATOS
# ===========================================
# Generado automáticamente por Ansible
# Rol: {{ role_name }}
# Host: {{ ansible_hostname }}

DB_NAME="{{ db_name }}"
DB_USER="{{ db_user }}"
DB_HOST="{{ db_host }}"
BACKUP_DIR="{{ db_base_dir }}/backups"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="$BACKUP_DIR/${DB_NAME}_${TIMESTAMP}.sql"

# Crear directorio de respaldos si no existe
mkdir -p "$BACKUP_DIR"

echo "Iniciando respaldo de la base de datos..."

# Realizar respaldo
mysqldump -h "$DB_HOST" -u "$DB_USER" -p "$DB_NAME" > "$BACKUP_FILE"

if [ $? -eq 0 ]; then
    echo "Respaldo completado exitosamente: $BACKUP_FILE"
    
    # Comprimir el respaldo
    gzip "$BACKUP_FILE"
    echo "Respaldo comprimido: ${BACKUP_FILE}.gz"
    
    # Limpiar respaldos antiguos (más de 7 días)
    find "$BACKUP_DIR" -name "*.sql.gz" -mtime +7 -delete
    echo "Respaldos antiguos eliminados"
else
    echo "Error al realizar el respaldo"
    exit 1
fi 
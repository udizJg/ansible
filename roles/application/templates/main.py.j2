#!/usr/bin/env python3
# ===========================================
# APLICACIÓN PRINCIPAL
# ===========================================
# Generada automáticamente por Ansible
# Rol: {{ role_name }}
# Host: {{ ansible_hostname }}

from flask import Flask, jsonify
import os
import datetime

app = Flask(__name__)

# Configuración
app.config['SECRET_KEY'] = '{{ app_secret_key }}'
app.config['DEBUG'] = {{ app_debug | lower }}

@app.route('/')
def index():
    return jsonify({
        'message': 'Aplicación configurada con Ansible',
        'rol': '{{ role_name }}',
        'host': '{{ ansible_hostname }}',
        'timestamp': datetime.datetime.now().isoformat()
    })

@app.route('/health')
def health():
    return jsonify({
        'status': 'healthy',
        'rol': '{{ role_name }}',
        'port': {{ app_port }}
    })

@app.route('/info')
def info():
    return jsonify({
        'app_name': '{{ app_name }}',
        'app_port': {{ app_port }},
        'app_debug': {{ app_debug | lower }},
        'db_host': '{{ app_db_host }}',
        'db_port': {{ app_db_port }},
        'db_name': '{{ app_db_name }}'
    })

if __name__ == '__main__':
    app.run(host='0.0.0.0', port={{ app_port }}, debug={{ app_debug | lower }}) 